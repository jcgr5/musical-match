generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model client {
  id                   String                 @id @default(cuid())
  username             String                 @unique(map: "Client_username_key") @db.VarChar(30)
  password             String                 @db.VarChar(255)
  name                 String                 @db.VarChar(50)
  email                String                 @unique(map: "Client_email_key") @db.VarChar(50)
  phone                String                 @db.VarChar(20)
  completedreservation completedreservation[]
  message              message[]
  reservation          reservation[]
  review               review[]
}

model completedreservation {
  id              String        @id @default(cuid())
  clientId        String
  musicianId      String
  reservationDate DateTime      @default(now())
  paymentMethodId String
  client          client        @relation(fields: [clientId], references: [id], map: "CompletedReservation_clientId_fkey")
  musician        musician      @relation(fields: [musicianId], references: [id], map: "CompletedReservation_musicianId_fkey")
  paymentmethod   paymentmethod @relation(fields: [paymentMethodId], references: [id], map: "CompletedReservation_paymentMethodId_fkey")

  @@index([clientId], map: "CompletedReservation_clientId_fkey")
  @@index([musicianId], map: "CompletedReservation_musicianId_fkey")
  @@index([paymentMethodId], map: "CompletedReservation_paymentMethodId_fkey")
}

model instrument {
  id                 String               @id @default(cuid())
  name               String               @db.VarChar(30)
  musicianinstrument musicianinstrument[]
}

model media {
  id         String   @id @default(cuid())
  musicianId String
  mediaType  String   @db.VarChar(10)
  filePath   String   @db.VarChar(255)
  uploadDate DateTime @default(now())
  musician   musician @relation(fields: [musicianId], references: [id], map: "Media_musicianId_fkey")

  @@index([musicianId], map: "Media_musicianId_fkey")
}

model message {
  id            String      @id @default(cuid())
  clientId      String
  musicianId    String
  content       String      @db.Text
  timestamp     DateTime    @default(now())
  reservationId String
  client        client      @relation(fields: [clientId], references: [id], map: "Message_clientId_fkey")
  musician      musician    @relation(fields: [musicianId], references: [id], map: "Message_musicianId_fkey")
  reservation   reservation @relation(fields: [reservationId], references: [id], map: "Message_reservationId_fkey")

  @@index([clientId], map: "Message_clientId_fkey")
  @@index([musicianId], map: "Message_musicianId_fkey")
  @@index([reservationId], map: "Message_reservationId_fkey")
}

model musicalgenre {
  id            String          @id @default(cuid())
  name          String          @db.VarChar(30)
  musiciangenre musiciangenre[]
}

model musician {
  id                   String                 @id @default(cuid())
  username             String                 @unique(map: "Musician_username_key") @db.VarChar(30)
  password             String                 @db.VarChar(255)
  name                 String                 @db.VarChar(50)
  email                String                 @unique(map: "Musician_email_key") @db.VarChar(50)
  phone                String                 @db.VarChar(20)
  completedreservation completedreservation[]
  media                media[]
  message              message[]
  musiciangenre        musiciangenre[]
  musicianinstrument   musicianinstrument[]
  reservation          reservation[]
  review               review[]
}

model musiciangenre {
  id             String       @id @default(cuid())
  musicianId     String
  musicalGenreId String
  musicalgenre   musicalgenre @relation(fields: [musicalGenreId], references: [id], map: "MusicianGenre_musicalGenreId_fkey")
  musician       musician     @relation(fields: [musicianId], references: [id], map: "MusicianGenre_musicianId_fkey")

  @@unique([musicianId, musicalGenreId], map: "MusicianGenre_musicianId_musicalGenreId_key")
  @@index([musicalGenreId], map: "MusicianGenre_musicalGenreId_fkey")
}

model musicianinstrument {
  id           String     @id @default(cuid())
  musicianId   String
  instrumentId String
  instrument   instrument @relation(fields: [instrumentId], references: [id], map: "MusicianInstrument_instrumentId_fkey")
  musician     musician   @relation(fields: [musicianId], references: [id], map: "MusicianInstrument_musicianId_fkey")

  @@unique([musicianId, instrumentId], map: "MusicianInstrument_musicianId_instrumentId_key")
  @@index([instrumentId], map: "MusicianInstrument_instrumentId_fkey")
}

model paymentmethod {
  id                   String                 @id @default(cuid())
  name                 String                 @db.VarChar(30)
  completedreservation completedreservation[]
}

model requeststatus {
  id   String @id @default(cuid())
  name String @db.VarChar(20)
}

model reservation {
  id                  String            @id @default(cuid())
  clientId            String
  musicianId          String
  price               Decimal           @db.Decimal(10, 2)
  creationDate        DateTime          @default(now())
  serviceDate         DateTime
  reservationStatusId String
  message             message[]
  client              client            @relation(fields: [clientId], references: [id], map: "Reservation_clientId_fkey")
  musician            musician          @relation(fields: [musicianId], references: [id], map: "Reservation_musicianId_fkey")
  reservationstatus   reservationstatus @relation(fields: [reservationStatusId], references: [id], map: "Reservation_reservationStatusId_fkey")

  @@index([clientId], map: "Reservation_clientId_fkey")
  @@index([musicianId], map: "Reservation_musicianId_fkey")
  @@index([reservationStatusId], map: "Reservation_reservationStatusId_fkey")
}

model reservationstatus {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(20)
  reservation reservation[]
}

model review {
  id           String   @id @default(cuid())
  clientId     String
  musicianId   String
  calificacion Int
  description  String?  @db.Text
  reviewDate   DateTime @default(now())
  client       client   @relation(fields: [clientId], references: [id], map: "Review_clientId_fkey")
  musician     musician @relation(fields: [musicianId], references: [id], map: "Review_musicianId_fkey")

  @@index([clientId], map: "Review_clientId_fkey")
  @@index([musicianId], map: "Review_musicianId_fkey")
}
